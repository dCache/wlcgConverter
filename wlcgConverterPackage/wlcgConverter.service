# this unit file is kept in /etc/systemd/system
# Version: 2.0 (2026-10-26)

[Unit]
Description=Wlcg_Converter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# the Python of the virtual environment that holds the pinned packages (see README);
# the script's own '#!/usr/bin/env python3' would pick the system Python
ExecStart=/opt/wlcgConverter/venv/bin/python /opt/wlcgConverter/wlcgConverter.py /etc/wlcg_converter/wlcgConverter_config.yaml
Restart=always
# wait between restarts, so a failing start does not reconnect to Kafka, the broker
# and scitags.org many times a second
RestartSec=30
# exit code 2 is an invalid configuration, which a restart cannot fix
RestartPreventExitStatus=2

# run as a dedicated user, not root; the user must be able to read the config and certificates
User=wlcgconverter
Group=wlcgconverter
# files the converter creates (log, local dump, SciTag cache) are readable by that user only
UMask=0077
NoNewPrivileges=yes
# /var/log/wlcg_converter and /var/lib/wlcg_converter, created and owned by the user;
# 0700 so other users cannot even list the file names
LogsDirectory=wlcg_converter
LogsDirectoryMode=0700
StateDirectory=wlcg_converter
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
